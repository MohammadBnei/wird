data/raw/
qa-report.json

# Go
/bin/
*.test
# `go build ./server/cmd/...` names its output after the last path element and
# drops it here. A 2.6 MB Mach-O called `cmd` was one `git add -A` away from
# the history; several agents commit in this repo and only one of them has to
# be careless.
/cmd
/api
/etl
/ingest
/rootcheck
/adminweb
/rootd

# Flutter / Dart
.fvm/
.dart_tool/
app/build/
app/.flutter-plugins*
app/ios/Pods/
app/ios/.symlinks/
app/macos/Pods/

*.db
# The bundled corpus ships inside the app; without it there is no data offline.
!app/assets/corpus.db
.DS_Store

# Golden failure output: written by a failing run, never committed.
app/test/failures/

# CodeGraph's index: a local cache rebuilt by `codegraph init`, and it holds a
# copy of the tree. Machine-local, like .dart_tool.
/.codegraph/

# Rendered screens a gate agent left behind while looking at its own work.
app/gate-shots/
