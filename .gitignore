data/raw/
qa-report.json

# Go
/bin/
*.test
# `go build ./server/cmd/...` names its output after the last path element and
# drops it here. A 2.6 MB Mach-O called `cmd` was one `git add -A` away from
# the history; several agents commit in this repo and only one of them has to
# be careless.
/cmd
/api
/etl
/ingest
/rootcheck
/rootdraft
/senseseed
/adminweb
/rootd
# And beside the module they were built from, which is where `go build ./cmd/x`
# run from inside `server/` or `jidhr/` puts them. Anchored one by one rather
# than as a bare name: `api` unanchored would swallow `server/internal/api`.
/server/api
/server/adminweb
/server/etl
/server/ingest
/server/jidhrcorpus
/server/rootcheck
/server/rootdraft
/server/senseseed
/jidhr/rootd
/jidhr/rootcheck

# Flutter / Dart
.fvm/
.dart_tool/
app/build/
app/.flutter-plugins*
app/ios/Pods/
app/ios/.symlinks/
app/macos/Pods/

*.db
# The bundled corpus ships inside the app; without it there is no data offline.
!app/assets/corpus.db
.DS_Store

# Golden failure output: written by a failing run, never committed.
app/test/failures/

# CodeGraph's index: a local cache rebuilt by `codegraph init`, and it holds a
# copy of the tree. Machine-local, like .dart_tool.
/.codegraph/

# Rendered screens a gate agent left behind while looking at its own work.
app/gate-shots/
__pycache__/
.claude/worktrees/
.claude/settings.local.json
