  "aboutLicencePermission": "Used by permission",
  "@aboutLicencePermission": {
    "description": "The licence tag on The Last Dialogue card of the sources screen: the use was granted by email rather than under a published licence."
  },
  "aboutTermsCorpus": "Every root a word opens into comes from here. Verbatim copies only — changing the annotation is not allowed. Used on the condition that its source is clearly indicated and a link is made to corpus.quran.com, so you can keep track of what has changed since this build.",
  "@aboutTermsCorpus": {
    "description": "The body of the Quranic Arabic Corpus card of the sources screen: what it provides and the conditions it is used on."
  },
  "aboutTermsTanzil": "The verified Uthmani text every aya is painted from, which the Quranic Arabic Corpus also builds on. Copied verbatim; changing the text is not allowed. Linked so you can keep track of changes.",
  "@aboutTermsTanzil": {
    "description": "The body of the Tanzil Project card of the sources screen."
  },
  "aboutTermsQuranFoundation": "The English under each word, served by the quran.com API. Their terms allow an application to show this content but not to store it indefinitely without a weekly re-sync, which a bundled corpus does not do. Unsettled, and recorded as unsettled.",
  "@aboutTermsQuranFoundation": {
    "description": "The body of the Quran Foundation card of the sources screen. The French adds that a French reader sees The Last Dialogue's glosses, with the English only as the fallback."
  },
  "aboutTermsLastDialogue": "The French under each word, for a reader who reads Wird in French. The site marks its word-by-word as in beta. They granted Wird its use by email on 30 September 2026 without requiring attribution; Wird names them anyway, because it names every source.",
  "@aboutTermsLastDialogue": {
    "description": "The body of The Last Dialogue card of the sources screen."
  },
  "aboutTermsNocturne": "The design system every screen is drawn from. Dark only; there is no light mode.",
  "@aboutTermsNocturne": {
    "description": "The body of the Nocturne card of the sources screen."
  },
  "aboutTermsScheherazade": "Bundled unmodified, because platform Arabic faces mangle Qurʼanic diacritics.",
  "@aboutTermsScheherazade": {
    "description": "The body of the Scheherazade New card of the sources screen. Feminine in French: it agrees with « police »."
  },
  "aboutTermsInter": "Bundled unmodified.",
  "@aboutTermsInter": {
    "description": "The body of the Inter card of the sources screen. Feminine in French: it agrees with « police »."
  },
  "aboutTermsTimings": "The millisecond each word is spoken at, which is what lets a word light up as you hear it. From github.com/cpfair/quran-align, aligned against this same muʿallim recording. Reindexed for this app: the published data is zero-based and end-exclusive, and it is stored here one-based against the word it belongs to. Offered as-is, without warranties.",
  "@aboutTermsTimings": {
